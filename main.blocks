<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id="KFSgIS!n+Bx=D_axB}lz" x="20" y="20"><statement name="HANDLER"><block type="typescript_statement" id="jqODoKYN1N[a0Q1Du_p}"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace settingsDecoder {&#13;" line1="&#13;" line2="    /**&#13;" line3="     * Encodes and saves a visual image canvas to a specific picture slot ID for future playthroughs&#13;" line4="     * @param imageId a unique name or number for this specific picture, eg: &quot;hero_sprite&quot;&#13;" line5="     * @param myImage The visual image grid drawn by the programmer&#13;" line6="     */&#13;" line7="    //% group=&quot;Image Decoder&quot;&#13;" line8="    //% block=&quot;encode image to slot %imageId from %myImage&quot;&#13;" line9="    //% myImage.shadow=&quot;screen_image_picker&quot;&#13;" line10="    //% imageId.defl=&quot;hero_sprite&quot;&#13;" line11="    export function encodeImageToSlot(imageId: string, myImage: Image): void {&#13;" line12="        if (!imageId || !myImage) return;&#13;" line13="&#13;" line14="        let width = myImage.width;&#13;" line15="        let height = myImage.height;&#13;" line16="&#13;" line17="        // Save dimensions using a dynamic unique key name&#13;" line18="        settings.writeNumberArray(&quot;pxt_img_dim_&quot; + imageId, [width, height]);&#13;" line19="&#13;" line20="        // Flatten the 2D canvas rows into a 1D color array&#13;" line21="        let colorArray: number[] = [];&#13;" line22="        for (let y = 0; y &lt; height; y++) {&#13;" line23="            for (let x = 0; x &lt; width; x++) {&#13;" line24="                colorArray.push(myImage.getPixel(x, y));&#13;" line25="            }&#13;" line26="        }&#13;" line27="&#13;" line28="        // Save the unique color array to memory&#13;" line29="        settings.writeNumberArray(&quot;pxt_img_col_&quot; + imageId, colorArray);&#13;" line30="    }&#13;" line31="&#13;" line32="    /**&#13;" line33="     * Decodes a saved image layout from a specific slot ID and returns it as an Image asset&#13;" line34="     * @param imageId the unique name or number of the picture slot to load, eg: &quot;hero_sprite&quot;&#13;" line35="     */&#13;" line36="    //% group=&quot;Image Decoder&quot;&#13;" line37="    //% block=&quot;decode image from slot %imageId&quot;&#13;" line38="    //% imageId.defl=&quot;hero_sprite&quot;&#13;" line39="    export function decodeImageFromSlot(imageId: string): Image {&#13;" line40="        let dimKey = &quot;pxt_img_dim_&quot; + imageId;&#13;" line41="        let colKey = &quot;pxt_img_col_&quot; + imageId;&#13;" line42="&#13;" line43="        // If slot keys don't exist yet, return a safe blank 1x1 fallback pixel&#13;" line44="        if (!settings.exists(dimKey) || !settings.exists(colKey)) {&#13;" line45="            return image.create(1, 1);&#13;" line46="        }&#13;" line47="&#13;" line48="        let dimensions = settings.readNumberArray(dimKey);&#13;" line49="        let colors = settings.readNumberArray(colKey);&#13;" line50="&#13;" line51="        if (!dimensions || dimensions.length &lt; 2 || !colors) {&#13;" line52="            return image.create(1, 1);&#13;" line53="        }&#13;" line54="&#13;" line55="        let imgWidth = dimensions[0];&#13;" line56="        let imgHeight = dimensions[1];&#13;" line57="        let decodedImg = image.create(imgWidth, imgHeight);&#13;" line58="&#13;" line59="        // Reconstruct the unique visual image grid&#13;" line60="        for (let y2 = 0; y2 &lt; imgHeight; y2++) {&#13;" line61="            for (let x2 = 0; x2 &lt; imgWidth; x2++) {&#13;" line62="                let colorIndex = (y2 * imgWidth) + x2;&#13;" line63="                if (colorIndex &lt; colors.length) {&#13;" line64="                    decodedImg.setPixel(x2, y2, colors[colorIndex]);&#13;" line65="                }&#13;" line66="            }&#13;" line67="        }&#13;" line68="&#13;" line69="        return decodedImg;&#13;" line70="    }&#13;" line71="&#13;" line72="    /**&#13;" line73="     * Completely wipes a saved picture slot from the console's memory&#13;" line74="     * @param imageId the unique name or number of the picture slot to delete, eg: &quot;hero_sprite&quot;&#13;" line75="     */&#13;" line76="    //% group=&quot;Image Decoder&quot;&#13;" line77="    //% block=&quot;clear saved image slot %imageId&quot;&#13;" line78="    //% imageId.defl=&quot;hero_sprite&quot;&#13;" line79="    export function clearImageSlot(imageId: string): void {&#13;" line80="        let dimKey2 = &quot;pxt_img_dim_&quot; + imageId;&#13;" line81="        let colKey2 = &quot;pxt_img_col_&quot; + imageId;&#13;" line82="&#13;" line83="        // Remove the data keys permanently from flash storage&#13;" line84="        if (settings.exists(dimKey2)) {&#13;" line85="            settings.remove(dimKey2);&#13;" line86="        }&#13;" line87="        if (settings.exists(colKey2)) {&#13;" line88="            settings.remove(colKey2);&#13;" line89="        }&#13;" line90="    }&#13;" line91="}" numlines="92"></mutation></block></statement></block></xml>