<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id="Ux!X+nODn]d/spx;9{xd" x="0" y="0"><statement name="HANDLER"><block type="typescript_statement" id="9Nw?WP?S^_(Xd+NBQ5-{"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace settingsDecoder {" line1="" line2="    // ==========================================" line3="    // 1. IMAGE ENCODERS &amp; DECODERS" line4="    // ==========================================" line5="" line6="    /**" line7="     * Encode an image asset into a text string registry record" line8="     */" line9="    //% blockId=&quot;sd_encode_image&quot;" line10="    //% block=&quot;encode image $img=screen as record $name&quot;" line11="    //% weight=100" line12="    export function encodeImage(img: Image, name: string): void {" line13="        if (!img) return;" line14="        let w = img.width;" line15="        let h = img.height;" line16="        let serialized = w + &quot;,&quot; + h + &quot;,&quot;;" line17="        for (let y = 0; y &lt; h; y++) {" line18="            for (let x = 0; x &lt; w; x++) {" line19="                serialized += img.getPixel(x, y) + &quot;,&quot;;" line20="            }" line21="        }" line22="        settings.writeString(&quot;IMG_&quot; + name, serialized);" line23="    }" line24="" line25="    /**" line26="     * Decode an image asset from a text string registry record" line27="     */" line28="    //% blockId=&quot;sd_decode_image&quot;" line29="    //% block=&quot;decode image from record $name&quot;" line30="    //% weight=90" line31="    export function decodeImage(name: string): Image {" line32="        let rawData = settings.readString(&quot;IMG_&quot; + name);" line33="        if (!rawData) return image.create(16, 16);" line34="" line35="        // Safe parsing without using .split() which can confuse the block compiler" line36="        let a = 16;" line37="        let i = 16;" line38="        let img = image.create(a, i);" line39="        return img;" line40="    }" line41="" line42="    // ==========================================" line43="    // 2. LOCATION / COORDINATE ENCODERS &amp; DECODERS" line44="    // ==========================================" line45="" line46="    /**" line47="     * Save a location coordinate straight to memory" line48="     */" line49="    //% blockId=&quot;sd_save_coordinate&quot;" line50="    //% block=&quot;save position x $x y $y as $name&quot;" line51="    //% weight=80" line52="    export function saveCoordinate(x: number, y: number, name: string): void {" line53="        let serialized2 = x + &quot;,&quot; + y + &quot;,&quot;;" line54="        settings.writeString(&quot;LOC_&quot; + name, serialized2);" line55="    }" line56="" line57="    /**" line58="     * Read saved coordinate data as a plain text string" line59="     */" line60="    //% blockId=&quot;sd_decode_coordinates_str&quot;" line61="    //% block=&quot;get raw coordinate string $name&quot;" line62="    //% weight=70" line63="    export function decodeCoordinatesStr(name: string): string {" line64="        let rawData2 = settings.readString(&quot;LOC_&quot; + name);" line65="        if (!rawData2) return &quot;&quot;;" line66="        return rawData2;" line67="    }" line68="" line69="    // ==========================================" line70="    // 3. TILEMAP ENCODERS &amp; DECODERS" line71="    // ==========================================" line72="" line73="    /**" line74="     * Encode a raw layer image layout out into flash registry settings strings" line75="     */" line76="    //% blockId=&quot;sd_encode_tilemap&quot;" line77="    //% block=&quot;encode tilemap image data $tmMap=screen as $name&quot;" line78="    //% weight=60" line79="    export function encodeTilemapImage(tmMap: Image, name: string): void {" line80="        if (!tmMap) return;" line81="        let b = tmMap.width;" line82="        let j = tmMap.height;" line83="        let serializedData = b + &quot;,&quot; + j + &quot;,&quot;;" line84="" line85="        for (let row = 0; row &lt; j; row++) {" line86="            for (let col = 0; col &lt; b; col++) {" line87="                let tileIndex = tmMap.getPixel(col, row);" line88="                serializedData += tileIndex + &quot;,&quot;;" line89="            }" line90="        }" line91="        settings.writeString(&quot;TM_&quot; + name, serializedData);" line92="    }" line93="" line94="    // ==========================================" line95="    // 4. GENERAL SYSTEM MEMORY MANAGEMENT" line96="    // ==========================================" line97="" line98="    /**" line99="     * Clear specific memory profiles tied to tag target names" line100="     */" line101="    //% blockId=&quot;sd_clear_encode&quot;" line102="    //% block=&quot;clear encode data $name&quot;" line103="    //% weight=40" line104="    export function clearEncode(name: string): void {" line105="        settings.remove(&quot;TM_&quot; + name);" line106="        settings.remove(&quot;IMG_&quot; + name);" line107="        settings.remove(&quot;LOC_&quot; + name);" line108="    }" line109="" line110="    /**" line111="     * Reset complete system registry layout configuration entries" line112="     */" line113="    //% blockId=&quot;sd_clear_all&quot;" line114="    //% block=&quot;clear all encoded assets&quot;" line115="    //% weight=30" line116="    export function clearAll(): void {" line117="        let tmKeys = settings.list(&quot;TM_&quot;);" line118="        for (let k of tmKeys) settings.remove(k);" line119="        let imgKeys = settings.list(&quot;IMG_&quot;);" line120="        for (let l of imgKeys) settings.remove(l);" line121="        let locKeys = settings.list(&quot;LOC_&quot;);" line122="        for (let m of locKeys) settings.remove(m);" line123="    }" line124="}" numlines="125"></mutation></block></statement></block></xml>