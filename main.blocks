<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id="jFF9]nUeo+e8=e`$^+[A" x="0" y="0"><statement name="HANDLER"><block type="typescript_statement" id="GY1+6{%aHZS-wR}DGdml"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace settingsDecoder {&#13;" line1="&#13;" line2="    // Internal tracker key prefix to identify what data type is stored in the entry&#13;" line3="    const TYPE_PREFIX = &quot;sd_type_&quot;;&#13;" line4="&#13;" line5="    // ==========================================&#13;" line6="    // SUB-CATEGORY 1: ENCODERS&#13;" line7="    // ==========================================&#13;" line8="&#13;" line9="    /**&#13;" line10="     * Encodes a visual image canvas into system storage&#13;" line11="     * @param name The identification key name for this encode, eg: &quot;myImage&quot;&#13;" line12="     * @param img The visual image canvas drawn by the programmer&#13;" line13="     */&#13;" line14="    //% group=&quot;Encoders&quot;&#13;" line15="    //% block=&quot;Encode %name as %img&quot;&#13;" line16="    //% img.shadow=&quot;screen_image_picker&quot;&#13;" line17="    //% name.defl=&quot;myImage&quot;&#13;" line18="    export function encodeImage(name: string, img: Image): void {&#13;" line19="        if (!name || !img) return;&#13;" line20="        settings.writeString(TYPE_PREFIX + name, &quot;image&quot;);&#13;" line21="        settings.writeNumberArray(&quot;sd_img_dim_&quot; + name, [img.width, img.height]);&#13;" line22="        let colorArray: number[] = [];&#13;" line23="        for (let y = 0; y &lt; img.height; y++) {&#13;" line24="            for (let x = 0; x &lt; img.width; x++) {&#13;" line25="                colorArray.push(img.getPixel(x, y));&#13;" line26="            }&#13;" line27="        }&#13;" line28="        settings.writeNumberArray(&quot;sd_img_col_&quot; + name, colorArray);&#13;" line29="    }&#13;" line30="&#13;" line31="    /**&#13;" line32="     * Encodes any array type (Numbers, Strings, Booleans, etc.) into system storage&#13;" line33="     * @param name The identification key name for this encode, eg: &quot;myArray&quot;&#13;" line34="     * @param list The target array of any data type to encode&#13;" line35="     */&#13;" line36="    //% group=&quot;Encoders&quot;&#13;" line37="    //% block=&quot;Encode array %name as list %list&quot;&#13;" line38="    //% list.shadow=&quot;lists_create_with&quot;&#13;" line39="    //% name.defl=&quot;myArray&quot;&#13;" line40="    export function encodeAnyArray(name: string, list: any[]): void {&#13;" line41="        if (!name || !list) return;&#13;" line42="&#13;" line43="        // Save the overarching variable type&#13;" line44="        settings.writeString(TYPE_PREFIX + name, &quot;array&quot;);&#13;" line45="&#13;" line46="        // Convert the elements to text strings safely using a classic index loop&#13;" line47="        let flatStrings: string[] = [];&#13;" line48="        for (let i = 0; i &lt; list.length; i++) {&#13;" line49="            flatStrings.push(&quot;&quot; + list[i]);&#13;" line50="        }&#13;" line51="&#13;" line52="        let flatString = flatStrings.join(&quot;||sd_split||&quot;);&#13;" line53="        settings.writeString(&quot;sd_arr_&quot; + name, flatString);&#13;" line54="    }&#13;" line55="&#13;" line56="    /**&#13;" line57="     * Encodes a visual tilemap layout grid safely into storage&#13;" line58="     * @param name The identification key name for this encode, eg: &quot;myTilemap&quot;&#13;" line59="     * @param tilemapData The tilemap asset to save&#13;" line60="     */&#13;" line61="    //% group=&quot;Encoders&quot;&#13;" line62="    //% block=&quot;Encode tilemap %name as %tilemapData&quot;&#13;" line63="    //% tilemapData.shadow=&quot;tiles_tilemap_editor&quot;&#13;" line64="    //% name.defl=&quot;myTilemap&quot;&#13;" line65="    export function encodeTilemap(name: string, tilemapData: tiles.TileMapData): void {&#13;" line66="        if (!name || !tilemapData) return;&#13;" line67="&#13;" line68="        // Use property string bypass to safely grab the raw internal layout buffer&#13;" line69="        let rawBuffer = (tilemapData as any)[&quot;data&quot;] as Buffer;&#13;" line70="        if (!rawBuffer) return;&#13;" line71="&#13;" line72="        settings.writeString(TYPE_PREFIX + name, &quot;tilemap&quot;);&#13;" line73="        settings.writeNumber(&quot;sd_tm_scale_&quot; + name, tilemapData.scale);&#13;" line74="        settings.writeBuffer(&quot;sd_tm_buf_&quot; + name, rawBuffer);&#13;" line75="    }&#13;" line76="&#13;" line77="    /**&#13;" line78="     * Encodes spatial position points (both pixel X/Y coordinates and Grid Column/Row coordinates)&#13;" line79="     * @param name The identification key name for this encode, eg: &quot;myPosition&quot;&#13;" line80="     * @param pixelX Horizontal screen position coordinate, eg: 80&#13;" line81="     * @param pixelY Vertical screen position coordinate, eg: 60&#13;" line82="     * @param tileCol Horizontal grid tile column coordinate, eg: 5&#13;" line83="     * @param tileRow Vertical grid tile row coordinate, eg: 3&#13;" line84="     */&#13;" line85="    //% group=&quot;Encoders&quot;&#13;" line86="    //% block=&quot;Encode position %name with pixel x %pixelX y %pixelY tile col %tileCol row %tileRow&quot;&#13;" line87="    //% name.defl=&quot;myPosition&quot; pixelX.defl=80 pixelY.defl=60 tileCol.defl=5 tileRow.defl=3&#13;" line88="    export function encodePosition(name: string, pixelX: number, pixelY: number, tileCol: number, tileRow: number): void {&#13;" line89="        if (!name) return;&#13;" line90="        settings.writeString(TYPE_PREFIX + name, &quot;position&quot;);&#13;" line91="        settings.writeNumberArray(&quot;sd_pos_&quot; + name, [pixelX, pixelY, tileCol, tileRow]);&#13;" line92="    }&#13;" line93="&#13;" line94="    // ==========================================&#13;" line95="    // SUB-CATEGORY 2: DECODERS&#13;" line96="    // ==========================================&#13;" line97="&#13;" line98="    /**&#13;" line99="     * Gets the decoded value of the encode dynamically based on what was saved&#13;" line100="     * @param name The identification key name of the encode, eg: &quot;myImage&quot;&#13;" line101="     */&#13;" line102="    //% group=&quot;Decoders&quot;&#13;" line103="    //% block=&quot;Decoded value of %name&quot;&#13;" line104="    //% name.defl=&quot;myImage&quot;&#13;" line105="    export function decodedValueOf(name: string): any {&#13;" line106="        if (!settings.exists(TYPE_PREFIX + name)) return null;&#13;" line107="        let type = settings.readString(TYPE_PREFIX + name);&#13;" line108="&#13;" line109="        // 1. Decode Image Type&#13;" line110="        if (type == &quot;image&quot;) {&#13;" line111="            let dimKey = &quot;sd_img_dim_&quot; + name;&#13;" line112="            let colKey = &quot;sd_img_col_&quot; + name;&#13;" line113="            if (!settings.exists(dimKey) || !settings.exists(colKey)) return null;&#13;" line114="            let dimensions = settings.readNumberArray(dimKey);&#13;" line115="            let colors = settings.readNumberArray(colKey);&#13;" line116="            if (!dimensions || dimensions.length &lt; 2 || !colors) return null;&#13;" line117="&#13;" line118="            let imgWidth = dimensions[0];&#13;" line119="            let imgHeight = dimensions[1];&#13;" line120="            let decodedImg = image.create(imgWidth, imgHeight);&#13;" line121="&#13;" line122="            for (let y2 = 0; y2 &lt; imgHeight; y2++) {&#13;" line123="                for (let x2 = 0; x2 &lt; imgWidth; x2++) {&#13;" line124="                    let idx = (y2 * imgWidth) + x2;&#13;" line125="                    if (idx &lt; colors.length) decodedImg.setPixel(x2, y2, colors[idx]);&#13;" line126="                }&#13;" line127="            }&#13;" line128="            return decodedImg;&#13;" line129="        }&#13;" line130="&#13;" line131="        // 2. Decode Universal Array Type (Returns string elements array)&#13;" line132="        if (type == &quot;array&quot;) {&#13;" line133="            let arrKey = &quot;sd_arr_&quot; + name;&#13;" line134="            let raw = settings.readString(arrKey);&#13;" line135="            if (!raw) return [];&#13;" line136="            return raw.split(&quot;||sd_split||&quot;);&#13;" line137="        }&#13;" line138="&#13;" line139="        // 3. Decode Tilemap Type (Returns the compiled TileMapData buffer registry object)&#13;" line140="        if (type == &quot;tilemap&quot;) {&#13;" line141="            let bufKey = &quot;sd_tm_buf_&quot; + name;&#13;" line142="            let scaleKey = &quot;sd_tm_scale_&quot; + name;&#13;" line143="            if (!settings.exists(bufKey)) return null;&#13;" line144="&#13;" line145="            let storedBuf = settings.readBuffer(bufKey);&#13;" line146="            let storedScale = settings.readNumber(scaleKey) || 4; // Defaults to 16x16 tiles layout (2^4=16)&#13;" line147="&#13;" line148="            // Reconstructs a structural runtime clone map asset&#13;" line149="            return new tiles.TileMapData(storedBuf, image.create(16, 16), [], storedScale);&#13;" line150="        }&#13;" line151="&#13;" line152="        // 4. Decode Position Type (Returns array: [pixelX, pixelY, tileCol, tileRow])&#13;" line153="        if (type == &quot;position&quot;) {&#13;" line154="            let posKey = &quot;sd_pos_&quot; + name;&#13;" line155="            return settings.readNumberArray(posKey) || [];&#13;" line156="        }&#13;" line157="&#13;" line158="        return null;&#13;" line159="    }&#13;" line160="&#13;" line161="    // ==========================================&#13;" line162="    // SUB-CATEGORY 3: MEMORY MANAGEMENT&#13;" line163="    // ==========================================&#13;" line164="&#13;" line165="    /**&#13;" line166="     * Checks if an encoded item with this custom name exists in the memory&#13;" line167="     * @param name The identification key name to check, eg: &quot;myImage&quot;&#13;" line168="     */&#13;" line169="    //% group=&quot;Memory Management&quot;&#13;" line170="    //% block=&quot;Encoded value with name %name exists&quot;&#13;" line171="    //% name.defl=&quot;myImage&quot;&#13;" line172="    export function encodedValueExists(name: string): boolean {&#13;" line173="        return settings.exists(TYPE_PREFIX + name);&#13;" line174="    }&#13;" line175="&#13;" line176="    /**&#13;" line177="     * Clears a specific Encode permanently out of device memory storage profiles&#13;" line178="     * @param name The identification key name matching the encode to wipe, eg: &quot;myImage&quot;&#13;" line179="     */&#13;" line180="    //% group=&quot;Memory Management&quot;&#13;" line181="    //% block=&quot;Clear Encode %name&quot;&#13;" line182="    //% name.defl=&quot;myImage&quot;&#13;" line183="    export function clearEncode(name: string): void {&#13;" line184="        if (!name) return;&#13;" line185="        settings.remove(TYPE_PREFIX + name);&#13;" line186="        settings.remove(&quot;sd_img_dim_&quot; + name);&#13;" line187="        settings.remove(&quot;sd_img_col_&quot; + name);&#13;" line188="        settings.remove(&quot;sd_tm_scale_&quot; + name);&#13;" line189="        settings.remove(&quot;sd_tm_buf_&quot; + name);&#13;" line190="        settings.remove(&quot;sd_pos_&quot; + name);&#13;" line191="        settings.remove(&quot;sd_arr_&quot; + name);&#13;" line192="    }&#13;" line193="&#13;" line194="    /**&#13;" line195="     * Clears all encodes and settings permanently out of flash memory profiles&#13;" line196="     */&#13;" line197="    //% group=&quot;Memory Management&quot;&#13;" line198="    //% block=&quot;Clear All&quot;&#13;" line199="    export function clearAll(): void {&#13;" line200="        let allKeys = settings.list(&quot;&quot;);&#13;" line201="        for (let key of allKeys) {&#13;" line202="            settings.remove(key);&#13;" line203="        }&#13;" line204="    }&#13;" line205="}" numlines="206"></mutation></block></statement></block></xml>