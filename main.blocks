<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id="{(S;If]m]DlUALIea`6x" x="20" y="20"><statement name="HANDLER"><block type="typescript_statement" id="KC+;k(`Vai9o0k!_=W@%"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="enum LocationMode {&#13;" line1="    //% block=&quot;Player Position (X,Y)&quot;&#13;" line2="    PlayerPosition = 1,&#13;" line3="    //% block=&quot;Tile Location (Col,Row)&quot;&#13;" line4="    TileLocation = 2&#13;" line5="}" numlines="6"></mutation><next><block type="typescript_statement" id="fR02{?CZ)w=e_o8_g(@,"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace settingsDecoder {&#13;" line1="    let percentLoaded = 0;&#13;" line2="    let isLoading = false;&#13;" line3="&#13;" line4="    // Helper to draw the progress bar overlay safely on screen&#13;" line5="    function drawProgressUI() {&#13;" line6="        if (!isLoading) return;&#13;" line7="        screen.fillRect(10, 50, 140, 60, 11);&#13;" line8="        screen.fillRect(12, 52, 136, 56, 15);&#13;" line9="        screen.print(&quot;LOADING TILEMAP...&quot;, 20, 62, 9, image.font8);&#13;" line10="        screen.drawRect(20, 80, 120, 12, 1);&#13;" line11="        let barWidth = Math.floor((percentLoaded / 100) * 116);&#13;" line12="        if (barWidth &gt; 0) {&#13;" line13="            screen.fillRect(22, 82, barWidth, 8, 5);&#13;" line14="        }&#13;" line15="        screen.print(percentLoaded + &quot;%&quot;, 70, 96, 6, image.font5);&#13;" line16="    }&#13;" line17="&#13;" line18="    // ==========================================&#13;" line19="    // 1. IMAGE ENCODERS &amp; DECODERS&#13;" line20="    // ==========================================&#13;" line21="&#13;" line22="    /**&#13;" line23="     * Encode an image asset into a text string registry record&#13;" line24="     */&#13;" line25="    //% block=&quot;encode image $img=screen as record $imageName&quot;&#13;" line26="    //% group=&quot;Images&quot;&#13;" line27="    //% weight=100&#13;" line28="    export function encodeImage(img: Image, imageName: string): void {&#13;" line29="        if (!img) return;&#13;" line30="        let w = img.width;&#13;" line31="        let h = img.height;&#13;" line32="        let serialized = convertToText(w) + &quot;,&quot; + convertToText(h) + &quot;,&quot;;&#13;" line33="        for (let y = 0; y &lt; h; y++) {&#13;" line34="            for (let x = 0; x &lt; w; x++) {&#13;" line35="                serialized += convertToText(img.getPixel(x, y)) + &quot;,&quot;;&#13;" line36="            }&#13;" line37="        }&#13;" line38="        settings.writeString(&quot;IMG_&quot; + imageName, serialized);&#13;" line39="    }&#13;" line40="&#13;" line41="    /**&#13;" line42="     * Decode an image asset from a text string registry record (Universal Reporter Block)&#13;" line43="     */&#13;" line44="    //% block=&quot;decode image from record $decodeImgName&quot;&#13;" line45="    //% group=&quot;Images&quot;&#13;" line46="    //% weight=90&#13;" line47="    export function decodeImage(decodeImgName: string): Image {&#13;" line48="        let rawData = settings.readString(&quot;IMG_&quot; + decodeImgName);&#13;" line49="        if (!rawData) return image.create(16, 16);&#13;" line50="&#13;" line51="        let segments = rawData.split(&quot;,&quot;);&#13;" line52="        if (segments.length &lt; 2) return image.create(16, 16);&#13;" line53="&#13;" line54="        let wStr = segments[0];&#13;" line55="        let hStr = segments[1];&#13;" line56="        let a = parseInt(wStr);&#13;" line57="        let i = parseInt(hStr);&#13;" line58="        let img = image.create(a, i);&#13;" line59="&#13;" line60="        let offset = 2;&#13;" line61="        for (let j = 0; j &lt; a * i; j++) {&#13;" line62="            if (j + offset &gt;= segments.length) break;&#13;" line63="            let val = parseInt(segments[j + offset]);&#13;" line64="            let x2 = j % a;&#13;" line65="            let y2 = Math.floor(j / a);&#13;" line66="            img.setPixel(x2, y2, val);&#13;" line67="        }&#13;" line68="        return img;&#13;" line69="    }&#13;" line70="&#13;" line71="    // ==========================================&#13;" line72="    // 2. LOCATION / COORDINATE ENCODERS &amp; DECODERS&#13;" line73="    // ==========================================&#13;" line74="&#13;" line75="    /**&#13;" line76="     * Save target dynamic point data with choice menu configuration profiles&#13;" line77="     */&#13;" line78="    //% block=&quot;save current location using $mode as $locSaveName&quot;&#13;" line79="    //% group=&quot;Locations&quot;&#13;" line80="    //% weight=80&#13;" line81="    export function saveLocationCoordsMode(mode: LocationMode, locSaveName: string): void {&#13;" line82="        let xVal = 0;&#13;" line83="        let yVal = 0;&#13;" line84="        let scene = game.currentScene();&#13;" line85="&#13;" line86="        if (mode === LocationMode.PlayerPosition) {&#13;" line87="            xVal = scene.camera ? scene.camera.offsetX + 80 : 0;&#13;" line88="            yVal = scene.camera ? scene.camera.offsetY + 60 : 0;&#13;" line89="        } else if (mode === LocationMode.TileLocation) {&#13;" line90="            let pixelX = scene.camera ? scene.camera.offsetX + 80 : 0;&#13;" line91="            let pixelY = scene.camera ? scene.camera.offsetY + 60 : 0;&#13;" line92="            xVal = Math.floor(pixelX / 16);&#13;" line93="            yVal = Math.floor(pixelY / 16);&#13;" line94="        }&#13;" line95="&#13;" line96="        let serialized2 = convertToText(xVal) + &quot;,&quot; + convertToText(yVal) + &quot;,&quot;;&#13;" line97="        settings.writeString(&quot;LOC_&quot; + locSaveName, serialized2);&#13;" line98="    }&#13;" line99="&#13;" line100="    /**&#13;" line101="     * Decode a list of coordinate numbers from a text string registry record&#13;" line102="     */&#13;" line103="    //% block=&quot;decode layout coordinate list $locDecodeName&quot;&#13;" line104="    //% group=&quot;Locations&quot;&#13;" line105="    //% weight=70&#13;" line106="    export function decodeCoordinates(locDecodeName: string): number[] {&#13;" line107="        let rawData2 = settings.readString(&quot;LOC_&quot; + locDecodeName);&#13;" line108="        if (!rawData2) return [];&#13;" line109="&#13;" line110="        let segments2 = rawData2.split(&quot;,&quot;);&#13;" line111="        let coords: number[] = [];&#13;" line112="        for (let k = 0; k &lt; segments2.length; k++) {&#13;" line113="            if (segments2[k].length == 0) continue;&#13;" line114="            coords.push(parseInt(segments2[k]));&#13;" line115="        }&#13;" line116="        return coords;&#13;" line117="    }&#13;" line118="&#13;" line119="    // ==========================================&#13;" line120="    // 3. TILEMAP ENCODERS &amp; DECODERS&#13;" line121="    // ==========================================&#13;" line122="&#13;" line123="    /**&#13;" line124="     * Encode a raw layer image layout out into flash registry settings strings&#13;" line125="     */&#13;" line126="    //% block=&quot;encode tilemap image data $tmMap=screen as $tilemapSaveName&quot;&#13;" line127="    //% group=&quot;Tilemaps&quot;&#13;" line128="    //% weight=60&#13;" line129="    export function encodeTilemapImage(tmMap: Image, tilemapSaveName: string): void {&#13;" line130="        if (!tmMap) return;&#13;" line131="        let b = tmMap.width;&#13;" line132="        let l = tmMap.height;&#13;" line133="        let serializedData = convertToText(b) + &quot;,&quot; + convertToText(l) + &quot;,&quot;;&#13;" line134="&#13;" line135="        for (let row = 0; row &lt; l; row++) {&#13;" line136="            for (let col = 0; col &lt; b; col++) {&#13;" line137="                let tileIndex = tmMap.getPixel(col, row);&#13;" line138="                serializedData += convertToText(tileIndex) + &quot;,&quot;;&#13;" line139="            }&#13;" line140="        }&#13;" line141="        settings.writeString(&quot;TM_&quot; + tilemapSaveName, serializedData);&#13;" line142="    }&#13;" line143="&#13;" line144="    /**&#13;" line145="     * Decode tilemap strings back into a clean Image canvas structure format&#13;" line146="     */&#13;" line147="    //% block=&quot;decode tilemap $tilemapDecodeName with loading popup&quot;&#13;" line148="    //% group=&quot;Tilemaps&quot;&#13;" line149="    //% weight=50&#13;" line150="    export function decodeTilemapWithPopup(tilemapDecodeName: string): Image {&#13;" line151="        let rawData3 = settings.readString(&quot;TM_&quot; + tilemapDecodeName);&#13;" line152="        if (!rawData3) return image.create(16, 16);&#13;" line153="&#13;" line154="        let dataSegments = rawData3.split(&quot;,&quot;);&#13;" line155="        if (dataSegments.length &lt; 2) return image.create(16, 16);&#13;" line156="&#13;" line157="        let wStr2 = dataSegments[0];&#13;" line158="        let hStr2 = dataSegments[1];&#13;" line159="        let c = parseInt(wStr2);&#13;" line160="        let m = parseInt(hStr2);&#13;" line161="&#13;" line162="        let layersImage = image.create(c, m);&#13;" line163="&#13;" line164="        isLoading = true;&#13;" line165="        percentLoaded = 0;&#13;" line166="        game.currentScene().eventContext.registerFrameHandler(95, drawProgressUI);&#13;" line167="&#13;" line168="        let dataOffset = 2;&#13;" line169="        let totalTiles = c * m;&#13;" line170="&#13;" line171="        for (let n = 0; n &lt; totalTiles; n++) {&#13;" line172="            if (n + dataOffset &gt;= dataSegments.length) break;&#13;" line173="&#13;" line174="            let val2 = parseInt(dataSegments[n + dataOffset]);&#13;" line175="            let col2 = n % c;&#13;" line176="            let row2 = Math.floor(n / c);&#13;" line177="            layersImage.setPixel(col2, row2, val2);&#13;" line178="&#13;" line179="            if (n % c == 0) {&#13;" line180="                percentLoaded = Math.floor((n / totalTiles) * 100);&#13;" line181="                loops.pause(1);&#13;" line182="            }&#13;" line183="        }&#13;" line184="&#13;" line185="        percentLoaded = 100;&#13;" line186="        isLoading = false;&#13;" line187="&#13;" line188="        return layersImage;&#13;" line189="    }&#13;" line190="&#13;" line191="    // ==========================================&#13;" line192="    // 4. GENERAL SYSTEM MEMORY MANAGEMENT&#13;" line193="    // ==========================================&#13;" line194="&#13;" line195="    /**&#13;" line196="     * Clear specific memory profiles tied to tag target names&#13;" line197="     */&#13;" line198="    //% block=&quot;clear encode data $clearTargetName&quot;&#13;" line199="    //% group=&quot;Memory Management&quot;&#13;" line200="    //% weight=40&#13;" line201="    export function clearEncode(clearTargetName: string): void {&#13;" line202="        settings.remove(&quot;TM_&quot; + clearTargetName);&#13;" line203="        settings.remove(&quot;IMG_&quot; + clearTargetName);&#13;" line204="        settings.remove(&quot;LOC_&quot; + clearTargetName);&#13;" line205="    }&#13;" line206="&#13;" line207="    /**&#13;" line208="     * Reset complete system registry layout configuration entries&#13;" line209="     */&#13;" line210="    //% block=&quot;clear all encoded assets&quot;&#13;" line211="    //% group=&quot;Memory Management&quot;&#13;" line212="    //% weight=30&#13;" line213="    export function clearAll(): void {&#13;" line214="        let tmKeys = settings.list(&quot;TM_&quot;);&#13;" line215="        for (let o of tmKeys) settings.remove(o);&#13;" line216="        let imgKeys = settings.list(&quot;IMG_&quot;);&#13;" line217="        for (let p of imgKeys) settings.remove(p);&#13;" line218="        let locKeys = settings.list(&quot;LOC_&quot;);&#13;" line219="        for (let q of locKeys) settings.remove(q);&#13;" line220="    }&#13;" line221="}" numlines="222"></mutation></block></next></block></statement></block></xml>